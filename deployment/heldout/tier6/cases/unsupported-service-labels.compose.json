{
  "x-cstack": {
    "sink_source": "/workspace/sink",
    "database_source": "/workspace/db",
    "channel_source": "/workspace/channel",
    "budget": 2
  },
  "services": {
    "agent-a": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23701",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "agent-a"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/channel",
          "target": "/channel",
          "read_only": true
        }
      ],
      "x-cstack-role": "agent"
    },
    "agent-b": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23702",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "agent-b"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/channel",
          "target": "/channel",
          "read_only": true
        }
      ],
      "x-cstack-role": "agent"
    },
    "broker": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23700",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "broker"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/channel",
          "target": "/channel",
          "read_only": false
        },
        {
          "type": "bind",
          "source": "/workspace/db",
          "target": "/private",
          "read_only": false
        }
      ],
      "x-cstack-role": "broker"
    },
    "receiver": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23700",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "receiver"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/db",
          "target": "/private",
          "read_only": false
        },
        {
          "type": "bind",
          "source": "/workspace/sink",
          "target": "/output",
          "read_only": false
        }
      ],
      "x-cstack-role": "receiver"
    },
    "reviewer": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23703",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "reviewer"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/channel",
          "target": "/channel",
          "read_only": true
        }
      ],
      "x-cstack-role": "reviewer",
      "labels": {
        "synthetic.purpose": "static-review"
      }
    },
    "approver": {
      "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user": "23704",
      "environment": {
        "PYTHONPATH": "/slice",
        "SLICE_ROLE": "approver"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/workspace/channel",
          "target": "/channel",
          "read_only": true
        }
      ],
      "x-cstack-role": "approver"
    }
  },
  "networks": {
    "isolated": {
      "internal": true
    }
  }
}
