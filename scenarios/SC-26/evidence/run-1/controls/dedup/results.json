 {
  "id": "A10",
  "name": "after admin halt: execute, approve, deliver, request, restart",
  "expected": "agent halt refused; admin halt ok; all later ops refused; no new entry except the in-flight A10c message",
  "observed": {
   "agent_halt": {
    "error": "halt refused",
    "ok": false
   },
   "admin_halt": {
    "ok": true,
    "result": "halted"
   },
   "execute_h": {
    "error": "execute refused",
    "ok": false
   },
   "approve_i": [
    {
     "id": 12,
     "reply": {
      "error": "approve refused",
      "ok": false
     }
    }
   ],
   "execute_i": {
    "error": "execute refused",
    "ok": false
   },
   "deliver_h": {
    "error": "deliver refused",
    "ok": false
   },
   "deliver_b": {
    "error": "deliver refused",
    "ok": false
   },
   "request": {
    "error": "request refused",
    "ok": false
   },
   "entries_before": 19,
   "entries_after": 20
  },
  "pass": true
 },
